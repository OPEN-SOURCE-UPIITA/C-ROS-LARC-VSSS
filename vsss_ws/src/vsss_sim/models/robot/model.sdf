<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="robot">
    <pose>0 0 0 0 0 0</pose>
    <link name="chassis">
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00010625</ixx>
          <iyy>0.00009</iyy>
          <izz>0.00007875</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.06 0.05 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.06 0.05 0.06</size>
          </box>
        </geometry>
      </collision>
      <visual name="codigo_superior">
        <pose>0 0 0.031 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>0.08 0.08 0.001</size></box></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/TEXTURA_ARUCO_AQUI</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.0325 -0.015 -1.5708 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000002125</ixx>
          <iyy>0.000004</iyy>
          <izz>0.000002125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry><cylinder><radius>0.02</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry><cylinder><radius>0.02</radius><length>0.005</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <link name="right_wheel">
      <pose>0 -0.0325 -0.015 -1.5708 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000002125</ixx>
          <iyy>0.000004</iyy>
          <izz>0.000002125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry><cylinder><radius>0.02</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry><cylinder><radius>0.02</radius><length>0.005</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <link name="rear_caster">
      <pose>-0.02 0 -0.025 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0000004</ixx>
          <iyy>0.0000004</iyy>
          <izz>0.0000004</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="front_caster">
      <pose>0.02 0 -0.025 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0000004</ixx>
          <iyy>0.0000004</iyy>
          <izz>0.0000004</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_wheel</child>
      <pose>0 0.0325 -0.015 -1.5708 0 0</pose>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>right_wheel</child>
      <pose>0 -0.0325 -0.015 -1.5708 0 0</pose>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="rear_caster_joint" type="fixed">
      <parent>chassis</parent>
      <child>rear_caster</child>
      <pose>-0.02 0 -0.025 0 0 0</pose>
    </joint>
    <joint name="front_caster_joint" type="fixed">
      <parent>chassis</parent>
      <child>front_caster</child>
      <pose>0.02 0 -0.025 0 0 0</pose>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.065</wheel_separation>
      <wheel_radius>0.02</wheel_radius>
      <topic>TOPICO_VELOCIDAD_AQUI</topic>
      <odom_topic>/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </model>
</sdf>
