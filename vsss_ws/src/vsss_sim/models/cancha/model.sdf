<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="cancha">
    <static>true</static>
    <link name="cancha_link">
      <collision name="cancha_collision">
        <geometry>
          <mesh>
            <uri>materials/model/cancha.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="paredes_visual">
        <geometry>
          <mesh>
            <uri>materials/model/cancha.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <visual name="piso_textura">
        <pose>0 0 0.021 0 0 1.5708</pose>
        <geometry>
          <box>
            <size>1.3 1.7 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/texture/cancha_textura.png</albedo_map>
              <roughness>0.8</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
